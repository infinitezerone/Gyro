#!/usr/bin/env bash
# Gyro Project - Commit Message & English-Only Enforcement Hook

COMMIT_MSG_FILE="$1"
FIRST_LINE=$(head -n 1 "$COMMIT_MSG_FILE")

# 1. Allow merge commits and initial tags
if echo "$FIRST_LINE" | grep -qE "^Merge branch|Initial commit"; then
    exit 0
fi

# 2. Enforce English text and English punctuation. The character rule lives in
#    scripts/validate_commits.py so this hook and the pre-push validator cannot
#    drift apart: ASCII is fine, accented Latin letters are fine, and everything
#    else above ASCII is refused (CJK, other scripts, typographic punctuation,
#    symbols and emoji).
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
PYTHON_BIN=""
for candidate in python python3 py; do
    if command -v "$candidate" >/dev/null 2>&1; then
        PYTHON_BIN="$candidate"
        break
    fi
done

if [ -n "$PYTHON_BIN" ] && [ -n "$REPO_ROOT" ] && [ -f "$REPO_ROOT/scripts/validate_commits.py" ]; then
    if ! "$PYTHON_BIN" "$REPO_ROOT/scripts/validate_commits.py" --scan-file "$COMMIT_MSG_FILE"; then
        echo "========================================================================"
        echo "❌ COMMIT REJECTED: NON-ENGLISH CHARACTERS DETECTED"
        echo "========================================================================"
        exit 1
    fi
else
    # No Python: fall back to refusing every non-ASCII byte. Stricter than the rule
    # (an accented letter would be refused too) but it never lets CJK through.
    if LC_ALL=C grep -n '[^[:print:][:space:]]' "$COMMIT_MSG_FILE" >/dev/null 2>&1; then
        echo "========================================================================"
        echo "❌ COMMIT REJECTED: NON-ASCII CHARACTERS DETECTED"
        echo "------------------------------------------------------------------------"
        echo "Python is unavailable, so this hook cannot tell letters from punctuation."
        echo "Offending line(s):"
        LC_ALL=C grep -n '[^[:print:][:space:]]' "$COMMIT_MSG_FILE"
        echo "========================================================================"
        exit 1
    fi
fi

# 3. Enforce Conventional Commits Format: <type>(<scope>): <subject>
# Allowed types: feat, fix, perf, refactor, test, build, ci, docs, chore, style, revert
PATTERN='^(feat|fix|perf|refactor|test|build|ci|docs|chore|style|revert)(\([a-z0-9_-]+\))?!?: [a-zA-Z0-9].*[^.]$'

if ! echo "$FIRST_LINE" | grep -E -q "$PATTERN"; then
    echo "========================================================================"
    echo "❌ COMMIT REJECTED: INVALID CONVENTIONAL COMMIT FORMAT"
    echo "------------------------------------------------------------------------"
    echo "Subject was: \"$FIRST_LINE\""
    echo ""
    echo "Format must strictly follow: <type>(<scope>): <subject>"
    echo ""
    echo "Allowed types:"
    echo "  feat, fix, perf, refactor, test, build, ci, docs, chore, style, revert"
    echo ""
    echo "Common scopes:"
    echo "  engine   (Rust NDK / EGL / mpv core)"
    echo "  player   (Kotlin player state machine / engine)"
    echo "  ui       (Compose player UI / controls)"
    echo "  shader   (Anime4K / GLSL shader pipeline)"
    echo "  test     (Automated stress / instrumented tests)"
    echo "  build    (Gradle / Cargo / NDK build scripts)"
    echo ""
    echo "Rules:"
    echo "  - English text and English punctuation only"
    echo "  - Do not end subject with a period ('.')"
    echo "  - Example: feat(ui): add real-time power and performance hud"
    echo "  - Example: fix(engine): eliminate sync_file fd leak in fence wrapper"
    echo "========================================================================"
    exit 1
fi

# 4. Check subject length (<= 80 chars)
LEN=${#FIRST_LINE}
if [ "$LEN" -gt 80 ]; then
    echo "⚠️  WARNING: Commit subject length is $LEN chars (> 80). Consider keeping it concise."
fi

exit 0
