#!/usr/bin/env bash
# Gyro Project - Pre-Push Safety Guard

echo "🔍 Running pre-push checks..."

# 1. Check for illegally tracked large binary files or build artifacts.
# The native engine is compiled by :core:engine:cargoNdkBuild, so any committed .so is a stale copy
# of crates/gyro-engine. --diff-filter=d keeps deletions out of the list, otherwise removing such a
# file from the tree would trip this very check.
FORBIDDEN_PATTERNS="\.apk$|\.dex$|\.hprof$|\.so$|/target/|/build/"
OFFENDING_FILES=$(git diff --name-only --diff-filter=d origin/master..HEAD 2>/dev/null | grep -E "$FORBIDDEN_PATTERNS" || true)

if [ -n "$OFFENDING_FILES" ]; then
    echo "========================================================================"
    echo "❌ PUSH REJECTED: FORBIDDEN BUILD ARTIFACTS OR BINARIES DETECTED"
    echo "------------------------------------------------------------------------"
    echo "The following forbidden files are present in the push range:"
    echo "$OFFENDING_FILES"
    echo "Please remove them or ensure they are listed in .gitignore."
    echo "========================================================================"
    exit 1
fi

# 2. Validate commit message convention and English-only constraint.
# Only the commits being pushed are checked: a fixed HEAD~10..HEAD window re-validates
# history that is already on the remote, so an unrelated old message can block a push.
RANGE="origin/master..HEAD"
if ! git rev-parse --verify origin/master >/dev/null 2>&1; then
    RANGE="HEAD~1..HEAD"
fi

if command -v python >/dev/null 2>&1; then
    python scripts/validate_commits.py "$RANGE" || exit 1
elif command -v python3 >/dev/null 2>&1; then
    python3 scripts/validate_commits.py "$RANGE" || exit 1
fi

echo "✅ Pre-push verification passed."
exit 0
